# Copy to .env for local dev. Never commit .env itself (see Section 7 of the spec).

# When true, api.js returns mocked responses shaped per Section 4.1
# instead of calling Backend. Flip to false once Backend endpoints are live.
VITE_USE_MOCKS=true

# Backend Spring Cloud Gateway base URL (used by vite.config.js dev proxy).
VITE_BACKEND_URL=http://localhost:8080
