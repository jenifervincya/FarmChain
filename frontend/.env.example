# Copy to .env for local dev. Never commit .env itself (see Section 7 of the spec).

# When true, api.js falls back to demo/synthetic data if a real Backend
# call fails. Real calls are attempted first regardless of this flag for
# farmer contact and notifications (per Jenifer's confirmed live endpoints).
VITE_USE_MOCKS=true

# Jenifer's confirmed local backend/API Gateway address (2026-08-13):
VITE_BACKEND_URL=http://localhost:8090

# Optional: free API key from https://data.gov.in/user/register — enables
# real government mandi price data in the fair-price chart. Without this,
# the chart falls back to consistent synthetic per-crop pricing.
VITE_MANDI_API_KEY=
